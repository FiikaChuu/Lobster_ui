# Lobster Water Quality Monitoring - Environment Configuration Example
# Copy this file to .env for local overrides

# Base REST API Gateway URL
VITE_API_BASE_URL=http://localhost:8000/api

# Data Provider Mode ('demo' for mock simulation, 'real' for production backend connection)
VITE_DATA_PROVIDER=demo

# Telemetry auto-polling interval in milliseconds (default: 5000ms = 5s)
VITE_POLLING_INTERVAL_MS=5000

# Telemetry staleness threshold in milliseconds (default: 60000ms = 60s)
VITE_STALE_THRESHOLD_MS=60000
